{%- comment -%}
  Ports apps/web/src/components/product/product-card.tsx.
  Expects: product (Shopify product object)
{%- endcomment -%}
{%- liquid
  assign primary_image = product.featured_media.preview_image | default: product.featured_image
  assign hover_image = product.media[1].preview_image
  assign sold_out = true
  for variant in product.variants
    if variant.available
      assign sold_out = false
    endif
  endfor
  assign compare_at = product.compare_at_price
  assign discount_pct = 0
  if compare_at > product.price
    assign discount_pct = compare_at | minus: product.price | times: 100 | divided_by: compare_at
  endif
-%}
<a href="{{ product.url }}" class="product-card" aria-label="{{ product.title | escape }}">
  <div class="product-card__frame{% if sold_out %} is-sold-out{% endif %}">
    {%- if primary_image -%}
      <img class="product-card__img product-card__img--primary{% if hover_image %} has-hover{% endif %}" src="{{ primary_image | image_url: width: 800 }}" alt="{{ primary_image.alt | escape }}" loading="lazy">
    {%- endif -%}
    {%- if hover_image -%}
      <img class="product-card__img product-card__img--hover" src="{{ hover_image | image_url: width: 800 }}" alt="" loading="lazy">
    {%- endif -%}

    <div class="product-card__badges">
      {%- if discount_pct > 0 and sold_out == false -%}
        <span class="product-card__badge product-card__badge--sale display">-{{ discount_pct }}%</span>
      {%- endif -%}
      {%- comment -%} Tags are lowercase in the catalogue, and `contains` is case-sensitive. {%- endcomment -%}
      {%- if product.tags contains 'new' -%}<span class="product-card__badge product-card__badge--new display">NEW</span>{%- endif -%}
      {%- if product.tags contains 'limited' -%}<span class="product-card__badge product-card__badge--limited display">LIMITED</span>{%- endif -%}
      {%- if product.tags contains 'trending' -%}<span class="product-card__badge product-card__badge--trending display">TRENDING</span>{%- endif -%}
      {%- if product.tags contains 'bestseller' -%}<span class="product-card__badge product-card__badge--bestseller display">BESTSELLER</span>{%- endif -%}
    </div>

    <button class="product-card__wish" data-wishlist-toggle data-product-id="{{ product.id }}" aria-label="Add to wishlist" onclick="event.preventDefault()">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.5-1.5 3-3.4 3-5.5A5.5 5.5 0 0 0 12 5a5.5 5.5 0 0 0-10 3.5C2 10.6 3.5 12.5 5 14l7 7Z"/></svg>
    </button>

    {%- if sold_out -%}
      <div class="product-card__soldout"><span class="display">SOLD OUT</span></div>
    {%- else -%}
      <div class="product-card__quickadd">
        {%- if product.variants.size > 1 -%}
          <div class="product-card__sizes" hidden data-quickadd-sizes>
            {%- for variant in product.variants -%}
              <button class="product-card__size-btn display" data-variant-id="{{ variant.id }}" data-add-to-cart {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title }}
              </button>
            {%- endfor -%}
          </div>
          <button class="product-card__quickadd-btn" data-quickadd-toggle onclick="event.preventDefault()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Quick Add
          </button>
        {%- else -%}
          <button class="product-card__quickadd-btn" data-variant-id="{{ product.selected_or_first_available_variant.id }}" data-add-to-cart onclick="event.preventDefault()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Quick Add
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__meta">
    <div class="product-card__title-row">
      <h3 class="product-card__title">{{ product.title }}</h3>
      {%- if product.metafields.reviews.rating_count.value > 0 -%}
        <span class="product-card__rating">
          <svg width="11" height="11" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2Z"/></svg>
          {{ product.metafields.reviews.rating.value | default: '—' }}
        </span>
      {%- endif -%}
    </div>

    <div class="product-card__price">
      <span class="product-card__price-now">{{ product.price | money }}</span>
      {%- if discount_pct > 0 -%}
        <span class="product-card__price-mrp">{{ compare_at | money }}</span>
      {%- endif -%}
    </div>

    <div class="product-card__foot">
      <div class="product-card__swatches">
        {%- assign color_option = product.options_with_values | where: 'name', 'Color' | first -%}
        {%- if color_option -%}
          {%- for value in color_option.values limit: 4 -%}
            <span class="product-card__swatch" title="{{ value }}" style="background:{{ value | handleize }};"></span>
          {%- endfor -%}
          {%- if color_option.values.size > 4 -%}
            <span class="product-card__swatch-more">+{{ color_option.values.size | minus: 4 }}</span>
          {%- endif -%}
        {%- endif -%}
      </div>
      {%- assign total_inventory = 0 -%}
      {%- for variant in product.variants -%}{%- assign total_inventory = total_inventory | plus: variant.inventory_quantity -%}{%- endfor -%}
      {%- if total_inventory > 0 and total_inventory <= 5 -%}
        <span class="product-card__lowstock">Few left</span>
      {%- endif -%}
    </div>
  </div>
</a>
