{%- comment -%}
  Ports apps/web/src/components/layout/wordmark.tsx — a code-drawn lockup,
  not an image asset. The rule + quatrefoil glyph only render at lg/xl.
  Params: size ("sm"|"md"|"lg"|"xl", default "md"), tone ("light"|"dark", default "light")
{%- endcomment -%}
{%- liquid
  assign wm_size = size | default: 'md'
  assign wm_tone = tone | default: 'light'
  assign with_rule = false
  if wm_size == 'lg' or wm_size == 'xl'
    assign with_rule = true
  endif
-%}
<span class="wordmark wordmark--{{ wm_size }} wordmark--{{ wm_tone }}">
  <span class="wordmark__name">HYRALUXE<span class="wordmark__dot">.</span></span>
  {%- if with_rule -%}
    <span class="wordmark__rule" aria-hidden="true">
      <span class="wordmark__rule-line"></span>
      <svg class="wordmark__glyph" viewBox="0 0 24 24" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="1.1">
          <path d="M12 12C9.2 9.6 9.2 6.4 12 4C14.8 6.4 14.8 9.6 12 12Z" transform="rotate(0 12 12)"></path>
          <path d="M12 12C9.2 9.6 9.2 6.4 12 4C14.8 6.4 14.8 9.6 12 12Z" transform="rotate(90 12 12)"></path>
          <path d="M12 12C9.2 9.6 9.2 6.4 12 4C14.8 6.4 14.8 9.6 12 12Z" transform="rotate(180 12 12)"></path>
          <path d="M12 12C9.2 9.6 9.2 6.4 12 4C14.8 6.4 14.8 9.6 12 12Z" transform="rotate(270 12 12)"></path>
        </g>
      </svg>
      <span class="wordmark__rule-line"></span>
    </span>
  {%- endif -%}
</span>
