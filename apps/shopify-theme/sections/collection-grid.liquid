{%- comment -%}
  Ports apps/web/src/components/catalog/catalog-view.tsx + catalog-controls.tsx.
  Covers both /category/[slug] and /collections/[collection] from the original
  site — Shopify collections handle both cases. Uses Shopify's native
  collection filtering (Search & Discovery) instead of the original's custom
  facet API.
{%- endcomment -%}
<div class="collection-head">
  <h1 class="display">
    {{ collection.title }}
    {%- if section.settings.accent != blank %} <span style="color:var(--color-volt);">{{ section.settings.accent }}</span>{% endif -%}
  </h1>
  {%- if collection.description != blank -%}
    <p style="margin-top:.5rem;max-width:32rem;font-size:.875rem;color:var(--color-paper-dim);">{{ collection.description }}</p>
  {%- endif -%}
</div>

<form id="CollectionFilterForm">
  <div class="collection-controls">
    <button type="button" class="display" data-filter-toggle style="display:flex;align-items:center;gap:.5rem;border:1px solid color-mix(in srgb, var(--color-paper) 30%, transparent);padding:.5rem 1rem;font-size:1rem;">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
      Filters
    </button>
    <div style="display:flex;align-items:center;gap:.75rem;">
      <span style="font-size:.75rem;color:var(--color-paper-dim);">{{ collection.products_count }} styles</span>
      <label>
        <span class="visually-hidden">Sort by</span>
        <select name="sort_by" onchange="this.form.submit()">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </label>
    </div>
  </div>

  <div data-filter-panel hidden style="border-bottom:1px solid color-mix(in srgb, var(--color-paper) 10%, transparent);padding-bottom:1.25rem;">
    <div style="display:grid;gap:1.5rem;padding-block:1.25rem;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));">
      {%- for filter in collection.filters -%}
        <fieldset>
          <legend class="display" style="margin-bottom:.625rem;font-size:1.125rem;">{{ filter.label }}</legend>
          {%- if filter.type == 'price_range' -%}
            <div style="display:flex;gap:.5rem;align-items:center;">
              <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" placeholder="Min" style="width:5rem;border:1px solid color-mix(in srgb, var(--color-paper) 25%, transparent);padding:.375rem;">
              <span>–</span>
              <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" placeholder="Max" style="width:5rem;border:1px solid color-mix(in srgb, var(--color-paper) 25%, transparent);padding:.375rem;">
            </div>
          {%- else -%}
            <div style="display:flex;flex-wrap:wrap;gap:.5rem;">
              {%- for value in filter.values -%}
                <label class="display" style="display:inline-flex;align-items:center;gap:.375rem;border:1px solid {% if value.active %}var(--color-paper){% else %}color-mix(in srgb, var(--color-paper) 30%, transparent){% endif %};background:{% if value.active %}var(--color-paper){% else %}transparent{% endif %};color:{% if value.active %}var(--color-ink){% else %}inherit{% endif %};padding:.375rem .75rem;font-size:.875rem;cursor:pointer;">
                  <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} onchange="this.form.submit()" style="display:none;">
                  {{ value.label }} ({{ value.count }})
                </label>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </fieldset>
      {%- endfor -%}
    </div>
    {%- if collection.filters.size > 0 -%}
      <a href="{{ collection.url }}" style="display:inline-flex;align-items:center;gap:.375rem;font-size:.875rem;color:var(--color-blood);text-decoration:underline;">Clear all filters</a>
    {%- endif -%}
  </div>
</form>

<div class="collection-grid">
  {%- paginate collection.products by 48 -%}
    {%- if collection.products.size == 0 -%}
      <div style="padding-block:6rem;text-align:center;">
        <p class="display" style="font-size:1.875rem;color:var(--color-paper-dim);">Nothing matches.</p>
        <p style="margin-top:.5rem;font-size:.875rem;color:var(--color-paper-dim);">Loosen a filter or two — the drop you want is hiding.</p>
      </div>
    {%- else -%}
      <div class="product-grid" style="margin-top:2rem;">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav style="margin-top:2.5rem;display:flex;justify-content:center;gap:.5rem;">
          {{ paginate | default_pagination }}
        </nav>
      {%- endif -%}
    {%- endif -%}
  {%- endpaginate -%}
</div>

<script>
  document.querySelector('[data-filter-toggle]')?.addEventListener('click', function () {
    var panel = document.querySelector('[data-filter-panel]');
    panel.hidden = !panel.hidden;
  });
</script>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "text", "id": "accent", "label": "Title accent word" }
  ]
}
{% endschema %}
