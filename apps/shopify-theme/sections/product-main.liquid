{%- comment -%}
  Ports apps/web/src/components/product/product-view.tsx.
  Pincode checker and size guide are UI shells per the migration plan —
  wired to placeholder behavior until Phase 3 picks a data source/app.
{%- endcomment -%}
{%- liquid
  comment
    Option layout varies per product: some carry Color + Size, the free-size
    sarees carry Color alone. Resolve each by name rather than by position so
    a single-option product doesn't render its colours as sizes.
  endcomment
  assign color_option = product.options_with_values | where: 'name', 'Color' | first
  assign size_option = product.options_with_values | where: 'name', 'Size' | first
  assign compare_at = product.selected_or_first_available_variant.compare_at_price | default: product.compare_at_price
  assign price = product.selected_or_first_available_variant.price | default: product.price
  assign discount_pct = 0
  if compare_at > price
    assign discount_pct = compare_at | minus: price | times: 100 | divided_by: compare_at
  endif
-%}
<div class="product-view" data-product-view data-product-handle="{{ product.handle }}">
  <div class="min-w-0">
    <nav class="product-view__breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      {%- if product.collections.first -%}
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      {%- endif -%}
    </nav>

    <div class="product-view__main-image" data-lightbox-open>
      {%- if product.selected_or_first_available_variant.featured_image -%}
        <img src="{{ product.selected_or_first_available_variant.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" data-main-image>
      {%- elsif product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" data-main-image>
      {%- endif -%}
      {%- if discount_pct > 0 -%}<span class="product-view__sale-badge display">-{{ discount_pct }}%</span>{%- endif -%}
    </div>

    {%- if product.media.size > 1 -%}
      <div class="product-view__thumbs no-scrollbar" data-thumbs>
        {%- for media in product.media -%}
          <button class="product-view__thumb{% if forloop.first %} is-active{% endif %}" data-thumb data-image="{{ media | image_url: width: 1200 }}" aria-label="View image {{ forloop.index }}">
            <img src="{{ media | image_url: width: 200 }}" alt="" loading="lazy">
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>

  <div class="min-w-0">
    <p class="product-view__eyebrow">{{ product.vendor }} · {{ product.type }}</p>
    <h1 class="product-view__title">{{ product.title }}</h1>

    {%- if product.metafields.reviews.rating_count.value > 0 -%}
      <div class="product-view__rating">
        <span class="product-view__rating-badge">
          <svg width="13" height="13" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2Z"/></svg>
          {{ product.metafields.reviews.rating.value }}
        </span>
        <span style="color:var(--color-paper-dim);">{{ product.metafields.reviews.rating_count.value }} reviews</span>
      </div>
    {%- endif -%}

    <div class="product-view__price-row">
      <span class="product-view__price-now" data-price>{{ price | money }}</span>
      {%- if discount_pct > 0 -%}
        <span class="product-view__price-mrp" data-compare-price>{{ compare_at | money }}</span>
        <span class="product-view__price-off" data-discount-pct>({{ discount_pct }}% OFF)</span>
      {%- endif -%}
    </div>
    <p class="product-view__tax-note">MRP inclusive of all taxes</p>

    <script type="application/json" data-variant-data>
      {
        "colorPosition": {% if color_option %}{{ color_option.position }}{% else %}null{% endif %},
        "sizePosition": {% if size_option %}{{ size_option.position }}{% else %}null{% endif %},
        "variants": [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id }},
              "options": {{ variant.options | json }},
              "price": {{ variant.price }},
              "compareAtPrice": {{ variant.compare_at_price | default: 0 }},
              "available": {{ variant.available }},
              "inventory": {{ variant.inventory_quantity | default: 0 }},
              "image": {{ variant.featured_image.src | default: '' | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>

    {%- if color_option -%}
      <div style="margin-top:1.25rem;">
        <p class="product-view__option-label">Colour: <span class="value" data-selected-color>{{ color_option.values.first }}</span></p>
        <div class="product-view__swatches">
          {%- for value in color_option.values -%}
            <button class="product-view__swatch{% if forloop.first %} is-active{% endif %}" data-color-swatch data-color="{{ value | escape }}" style="background:{{ value | handleize }};" title="{{ value }}"></button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if size_option -%}
      <div class="product-view__size-row">
        <div class="product-view__size-head">
          <p class="product-view__option-label" style="margin:0;">Size</p>
          <button type="button" class="product-view__size-guide-btn" data-size-guide-open>Size Guide</button>
        </div>
        <div class="product-view__sizes" data-size-list>
          {%- for value in size_option.values -%}
            <button class="product-view__size-btn" data-size-btn data-size="{{ value | escape }}">{{ value }}</button>
          {%- endfor -%}
        </div>
        <p class="product-view__lowstock" data-lowstock hidden></p>
      </div>
    {%- else -%}
      <p class="product-view__lowstock" data-lowstock hidden></p>
    {%- endif -%}

    <button class="product-view__add-btn display" data-add-to-cart-main disabled>
      {%- if size_option -%}Select A Size{%- else -%}Select A Colour{%- endif -%}
    </button>
    <p style="margin-top:.5rem;font-size:.875rem;color:var(--color-blood);" data-cart-error hidden></p>

    <div class="product-view__delivery">
      <div>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5v8h1"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
        Free shipping over ₹999 · COD available
      </div>
      <div>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
        <span>7-day returns · <a href="{{ routes.root_url }}pages/returns-policy" style="text-decoration:underline;">Policy</a></span>
      </div>
    </div>

    {%- comment -%} Pincode checker: UI shell only — real serviceability data source is a Phase-3 decision. {%- endcomment -%}
    <div style="margin-top:1.25rem;border:1px solid color-mix(in srgb, var(--color-paper) 10%, transparent);padding:1rem;">
      <p style="margin:0 0 .5rem;font-size:.875rem;font-weight:600;">Check delivery availability</p>
      <div style="display:flex;gap:.5rem;">
        <input type="text" inputmode="numeric" maxlength="6" placeholder="Enter pincode" style="flex:1;border:1px solid color-mix(in srgb, var(--color-paper) 25%, transparent);padding:.5rem .75rem;font-size:.875rem;">
        <button class="btn-secondary" type="button">Check</button>
      </div>
    </div>

    <div class="product-view__details">
      <div>
        <h2>The Story</h2>
        <p>{{ product.description }}</p>
      </div>
    </div>
  </div>

  <div class="product-sticky-buy" data-sticky-buy>
    <div class="product-sticky-buy__row">
      <div style="min-width:0;flex:1;">
        <p class="product-sticky-buy__name">{{ product.title }}</p>
        <p class="product-sticky-buy__price" data-sticky-price>{{ price | money }}</p>
      </div>
      <button data-buy-now disabled>Select A Size</button>
    </div>
  </div>
</div>

{%- comment -%} Size guide modal shell {%- endcomment -%}
<div class="modal-overlay" data-size-guide-modal>
  <div class="modal-panel">
    <button class="modal-close" data-size-guide-close aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <h2 class="display" style="font-size:1.5rem;">Size Guide</h2>
    <p style="margin-top:.5rem;font-size:.875rem;color:var(--color-paper-dim);">See the full <a href="{{ routes.root_url }}pages/size-guide" style="text-decoration:underline;">size guide</a> for detailed measurements.</p>
  </div>
</div>

<div class="lightbox-overlay" data-lightbox>
  <button class="lightbox-close" data-lightbox-close aria-label="Close">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
  </button>
  <img data-lightbox-image src="" alt="">
</div>

<script>window.__PRODUCT_ID__ = {{ product.id | json }};</script>
{{ 'product-view.js' | asset_url | script_tag }}

{% schema %}
{ "name": "Product main" }
{% endschema %}
