{%- comment -%} Ports apps/web/src/app/contact/page.tsx {%- endcomment -%}
<div class="page-shell">
  <h1>Contact Us<span class="accent">.</span></h1>
  <p class="page-shell__intro">Order help, returns, sizing or anything else — we're happy to help.</p>

  <div class="page-shell__body">
    <div style="display:grid;gap:.75rem;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
      {%- if settings.whatsapp_number != blank -%}
        <a href="https://wa.me/{{ settings.whatsapp_number }}?text=Hi!%20I%20have%20a%20question%20about%20my%20order." target="_blank" rel="noopener noreferrer" style="display:flex;align-items:flex-start;gap:.75rem;border:1px solid color-mix(in srgb, var(--color-paper) 10%, transparent);background:var(--color-ink-2);padding:1rem;transition:border-color .15s;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-volt)" stroke-width="2" style="margin-top:.125rem;flex-shrink:0;"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          <span><span style="display:block;font-weight:600;color:var(--color-paper);">WhatsApp</span><span style="font-size:.75rem;">Fastest — chat with us</span></span>
        </a>
      {%- endif -%}
      <a href="mailto:{{ settings.business_email }}" style="display:flex;align-items:flex-start;gap:.75rem;border:1px solid color-mix(in srgb, var(--color-paper) 10%, transparent);background:var(--color-ink-2);padding:1rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-volt)" stroke-width="2" style="margin-top:.125rem;flex-shrink:0;"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
        <span><span style="display:block;font-weight:600;color:var(--color-paper);">Email</span><span style="font-size:.75rem;word-break:break-all;">{{ settings.business_email }}</span></span>
      </a>
      {%- if settings.business_phone != blank -%}
        <a href="tel:+{{ settings.business_phone }}" style="display:flex;align-items:flex-start;gap:.75rem;border:1px solid color-mix(in srgb, var(--color-paper) 10%, transparent);background:var(--color-ink-2);padding:1rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-volt)" stroke-width="2" style="margin-top:.125rem;flex-shrink:0;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
          <span><span style="display:block;font-weight:600;color:var(--color-paper);">Phone</span><span style="font-size:.75rem;">+{{ settings.business_phone }}</span></span>
        </a>
      {%- endif -%}
      <div style="display:flex;align-items:flex-start;gap:.75rem;border:1px solid color-mix(in srgb, var(--color-paper) 10%, transparent);background:var(--color-ink-2);padding:1rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-volt)" stroke-width="2" style="margin-top:.125rem;flex-shrink:0;"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <span><span style="display:block;font-weight:600;color:var(--color-paper);">Support hours</span><span style="font-size:.75rem;">{{ section.settings.hours | default: "Mon–Sat, 10am–6pm IST" }}</span></span>
      </div>
    </div>

    {%- if settings.business_address != blank -%}
      <div class="policy-section">
        <h2>Business address</h2>
        <div><p style="display:flex;align-items:flex-start;gap:.5rem;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-volt)" stroke-width="2" style="margin-top:.125rem;flex-shrink:0;"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg><span>{{ settings.business_name }}<br>{{ settings.business_address }}</span></p></div>
      </div>
    {%- endif -%}

    <div class="policy-section">
      <h2>Order &amp; return help</h2>
      <div><p>For anything about an existing order, please include your <strong>order number</strong> so we can help faster. Return requests can also be raised directly from your order page within 7 days of delivery — see our <a href="{{ routes.root_url }}pages/returns-policy" style="color:var(--color-volt);text-decoration:underline;">returns policy</a>.</p></div>
    </div>

    <div class="policy-section">
      <h2>Response time</h2>
      <div><p>We reply to WhatsApp and email during support hours, usually the same day. Messages received on Sundays or public holidays are answered on the next working day.</p></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    { "type": "text", "id": "hours", "label": "Support hours", "default": "Mon–Sat, 10am–6pm IST" }
  ]
}
{% endschema %}
