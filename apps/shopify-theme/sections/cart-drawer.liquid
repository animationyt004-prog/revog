{%- comment -%} Ports apps/web/src/components/cart/cart-drawer.tsx using Shopify's Ajax Cart API {%- endcomment -%}
<div class="cart-overlay" data-cart-overlay></div>
<aside class="cart-drawer" role="dialog" aria-label="Shopping cart" data-cart-drawer>
  <div class="cart-drawer__head">
    <h2>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      Your Cart
      <span data-cart-count-label style="font-size:1rem;color:var(--color-paper-dim);font-family:var(--font-sans);font-weight:400;"></span>
    </h2>
    <button aria-label="Close cart" data-cart-close>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <div data-cart-body>
    {%- comment -%} Populated client-side from /cart.js by cart-drawer.js — see snippets/cart-drawer-empty for the static empty state fallback rendered on first paint. {%- endcomment -%}
    <div class="cart-drawer__empty">
      <div>
        <p>Bag's empty.</p>
        <p style="margin-top:.5rem;font-size:.875rem;color:var(--color-paper-dim)">The streets are waiting.</p>
        <button class="btn-primary" style="margin-top:1.5rem;font-size:1.125rem;padding:.75rem 1.5rem;" data-cart-close>Keep Shopping</button>
      </div>
    </div>
  </div>
</aside>

{{ 'cart-drawer.js' | asset_url | script_tag }}
