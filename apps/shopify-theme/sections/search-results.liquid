{%- comment -%} Ports apps/web/src/app/search/page.tsx {%- endcomment -%}
<div class="collection-head">
  <h1 class="display">Results for &ldquo;{{ search.terms }}&rdquo;</h1>
</div>
<div class="collection-grid" style="margin-top:1.5rem;">
  {%- paginate search.results by 48 -%}
    {%- if search.results_count == 0 -%}
      <div style="padding-block:6rem;text-align:center;">
        <p class="display" style="font-size:1.875rem;color:var(--color-paper-dim);">Nothing matches.</p>
        <p style="margin-top:.5rem;font-size:.875rem;color:var(--color-paper-dim);">Try a different search term.</p>
      </div>
    {%- else -%}
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{%- render 'product-card', product: item -%}{%- endif -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav style="margin-top:2.5rem;display:flex;justify-content:center;gap:.5rem;">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Search results" }
{% endschema %}
