{%- comment -%} Standalone /cart page — the drawer (sections/cart-drawer.liquid) is the primary cart UI; this covers direct visits and JS-off fallback. {%- endcomment -%}
<div class="page-shell">
  <h1>Your Cart<span class="accent">.</span></h1>
  {%- if cart.item_count == 0 -%}
    <p style="margin-top:1rem;color:var(--color-paper-dim);">Bag's empty. <a href="{{ routes.root_url }}" style="color:var(--color-volt);text-decoration:underline;">Keep shopping</a>.</p>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div style="margin-top:1.5rem;display:grid;gap:1rem;">
        {%- for item in cart.items -%}
          <div class="cart-line">
            <a href="{{ item.url }}" class="cart-line__img"><img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.product.title | escape }}"></a>
            <div class="cart-line__body">
              <p class="cart-line__title">{{ item.product.title }}</p>
              <p class="cart-line__variant">{{ item.variant.title }}</p>
              <div style="margin-top:auto;display:flex;align-items:center;justify-content:space-between;">
                <input type="number" name="updates[{{ forloop.index0 }}]" value="{{ item.quantity }}" min="0" style="width:4rem;border:1px solid color-mix(in srgb, var(--color-paper) 25%, transparent);padding:.25rem .5rem;">
                <p style="margin:0;font-weight:700;">{{ item.final_line_price | money }}</p>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div style="margin-top:1.5rem;display:flex;justify-content:space-between;align-items:center;">
        <button type="submit" name="update" class="btn-secondary">Update Cart</button>
        <p style="font-size:1.25rem;font-weight:700;">{{ cart.total_price | money }}</p>
      </div>
      <button type="submit" name="checkout" class="btn-primary" style="margin-top:1rem;width:100%;font-size:1.25rem;padding:1rem;">Checkout</button>
    </form>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Cart page" }
{% endschema %}
