{%- comment -%}
  Ports apps/web/src/components/home/hero.tsx, including its fallback: with no
  campaign artwork uploaded, the banner runs on catalogue photography from the
  fallback collection so it is never left as an empty dark panel.
{%- endcomment -%}
{%- assign fallback_products = collections[section.settings.fallback_collection].products -%}
<section class="hero" aria-roledescription="carousel" aria-label="New collection" data-hero>
  {%- for block in section.blocks -%}
    {%- liquid
      assign slide_image = block.settings.image
      if slide_image == blank
        assign fallback = fallback_products[forloop.index0]
        assign slide_image = fallback.featured_image
      endif
    -%}
    <div class="hero__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
      {%- if slide_image != blank -%}
        <img src="{{ slide_image | image_url: width: 1800 }}" alt="" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" {% if forloop.first %}fetchpriority="high"{% endif %}>
      {%- endif -%}
    </div>
  {%- endfor -%}

  <div class="hero__wash" aria-hidden="true"></div>
  <div class="hero__wash-bottom" aria-hidden="true"></div>

  <div class="hero__content">
    <div class="hero__copy">
      {%- for block in section.blocks -%}
        <div class="hero__slide-copy" data-hero-copy {% unless forloop.first %}hidden{% endunless %}>
          <p class="hero__eyebrow">{{ block.settings.eyebrow }}</p>
          <h1 class="hero__title display">
            {{ block.settings.title }}
            <span class="hero__title-accent">{{ block.settings.accent }}</span>
          </h1>
          <p class="hero__subtitle">{{ block.settings.subtitle }}</p>
          <div class="hero__ctas">
            <a href="{{ block.settings.cta_link }}" class="btn-gold display">
              {{ block.settings.cta_label }}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href="{{ section.settings.secondary_cta_link }}" class="btn-outline-light">{{ section.settings.secondary_cta_label }}</a>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="hero__panel">
      <div class="hero__panel-frame"></div>
      <div class="hero__panel-card">
        <p style="font-size:.625rem;font-weight:600;text-transform:uppercase;letter-spacing:.24em;color:var(--color-gold);margin:0;">{{ shop.name }} edit</p>
        <p class="display" style="margin-top:.5rem;font-size:1.5rem;">Drape-ready styles for every occasion.</p>
        <p style="margin-top:.75rem;font-size:.75rem;line-height:1.6;color:rgba(255,255,255,.68);">Sarees with blouse piece, honest pricing, and pan-India delivery.</p>
      </div>
    </div>
  </div>

  {%- if section.blocks.size > 1 -%}
    <button class="hero__nav hero__nav--prev" data-hero-prev aria-label="Previous slide">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button class="hero__nav hero__nav--next" data-hero-next aria-label="Next slide">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
    </button>
    <div class="hero__dots">
      {%- for block in section.blocks -%}
        <button class="hero__dot{% if forloop.first %} is-active{% endif %}" data-hero-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{{ 'hero.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "collection", "id": "fallback_collection", "label": "Fallback photography collection", "info": "Product photos used for any slide with no image uploaded." },
    { "type": "url", "id": "secondary_cta_link", "label": "Secondary CTA link" },
    { "type": "text", "id": "secondary_cta_label", "label": "Secondary CTA label", "default": "Shop sarees" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NEW COLLECTION" },
        { "type": "text", "id": "title", "label": "Title", "default": "Timeless elegance." },
        { "type": "text", "id": "accent", "label": "Accent line", "default": "Redefined for you." },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Indian fashion crafted for every moment that matters." },
        { "type": "url", "id": "cta_link", "label": "CTA link" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop new arrivals" }
      ]
    }
  ],
  "presets": [
    { "name": "Hero", "blocks": [{ "type": "slide" }] }
  ]
}
{% endschema %}
