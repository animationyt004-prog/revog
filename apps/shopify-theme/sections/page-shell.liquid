{%- comment -%}
  Generic page template. A few pages carry copy that belongs to the theme
  rather than the merchant (the size guide is measurement data, same as the
  original storefront hardcoded it), so those render their built-in content
  instead of the page body. Everything else renders whatever the merchant
  wrote in the admin.
{%- endcomment -%}
<div class="page-shell">
  <h1>{{ page.title }}<span class="accent">.</span></h1>
  {%- case page.handle -%}
    {%- when 'size-guide' -%}
      <p class="page-shell__intro">Sarees are free size. For everything else, here are our garment-flat measurements.</p>
      <div class="page-shell__body">
        {%- render 'size-guide-content' -%}
      </div>
    {%- else -%}
      <div class="page-shell__body">{{ page.content }}</div>
  {%- endcase -%}
</div>

{% schema %}
{ "name": "Page" }
{% endschema %}
