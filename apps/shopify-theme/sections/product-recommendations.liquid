{%- comment -%}
  Ports the "Pairs Well With" related rail from product-view.tsx, using
  Shopify's native product recommendations API. Rendered empty on normal
  page loads; assets/product-view.js re-fetches this section with the
  correct product_id/section_id query params (Shopify's documented pattern)
  and swaps in the populated markup.
{%- endcomment -%}
<div id="product-recommendations" data-recommendations data-recommendations-url="{{ routes.product_recommendations_url }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section>
      <div class="section-inner">
        <div class="section-head">
          <div>
            <p class="section-eyebrow">Curated edit</p>
            <h2 class="section-title display">Pairs Well <span class="accent">With</span></h2>
          </div>
        </div>
        <div class="product-rail no-scrollbar">
          {%- for product in recommendations.products -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Product recommendations" }
{% endschema %}
