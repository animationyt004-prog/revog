{%- comment -%} Ports apps/web/src/components/home/testimonials.tsx {%- endcomment -%}
<section class="testimonials" aria-label="Customer reviews">
  <div class="testimonials__inner">
    <div class="testimonials__head">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="1.4"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2Z"/></svg>
      <p class="testimonials__title display">Loved by our<span class="accent">customers</span></p>
      <p class="testimonials__note">Only verified purchase reviews are shown.</p>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="testimonials__rail no-scrollbar">
        {%- for block in section.blocks -%}
          <figure class="testimonial-card" {{ block.shopify_attributes }}>
            {%- if block.settings.photo != blank -%}
              <img src="{{ block.settings.photo | image_url: width: 600 }}" alt="Customer photo" loading="lazy">
            {%- endif -%}
            <div class="testimonial-card__body">
              <div class="testimonial-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                {%- for i in (1..block.settings.rating) -%}
                  <svg width="13" height="13" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2Z"/></svg>
                {%- endfor -%}
              </div>
              <blockquote class="testimonial-card__quote">{{ block.settings.quote }}</blockquote>
              <figcaption class="testimonial-card__foot">
                <span class="testimonial-card__verified">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
                  Verified purchase
                </span>
                <span style="display:block;margin-top:.25rem;">{{ block.settings.author }} &middot;
                  {%- if block.settings.product_link != blank %} <a href="{{ block.settings.product_link }}" style="text-decoration:underline;">{{ block.settings.product_name }}</a>{% else %} {{ block.settings.product_name }}{% endif -%}
                </span>
              </figcaption>
            </div>
          </figure>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div>
        <p style="max-width:36rem;font-size:.9375rem;line-height:1.7;color:rgba(255,255,255,.72);">
          Clear fabric details, true product photography, secure payments and human support when you need it.
        </p>
        <a href="/pages/about" style="margin-top:1.5rem;display:inline-block;border-bottom:1px solid var(--color-gold);padding-bottom:.25rem;font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.15em;color:var(--color-gold);">Discover {{ shop.name }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Customer photo" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "text", "id": "product_name", "label": "Product name" },
        { "type": "url", "id": "product_link", "label": "Product link" }
      ]
    }
  ],
  "presets": [
    { "name": "Testimonials" }
  ]
}
{% endschema %}
