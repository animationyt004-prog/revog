{%- comment -%} Ports apps/web/src/components/home/category-tiles.tsx {%- endcomment -%}
<section class="section-tone-soft">
  <div class="section-inner">
    <div class="section-head">
      <div>
        <p class="section-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="section-title display">{{ section.settings.title }}</h2>
      </div>
      <p style="max-width:24rem;font-size:.875rem;line-height:1.6;color:var(--color-paper-dim);margin:0;">{{ section.settings.description }}</p>
    </div>

    <ul class="category-tiles__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          comment
            Same fallback as the original site: a tile with no artwork uploaded
            borrows the first product photo from the collection it links to.
          endcomment
          assign tile_image = block.settings.image
          if tile_image == blank and block.settings.collection != blank
            comment
              Step through the collection by tile position so neighbouring
              tiles don't all land on the same first product photo — the
              collections overlap heavily.
            endcomment
            assign tile_products = collections[block.settings.collection].products
            assign offset_product = tile_products[forloop.index0]
            if offset_product == blank
              assign offset_product = tile_products.first
            endif
            assign tile_image = offset_product.featured_image
          endif
        -%}
        <li class="{% if forloop.first %}category-tiles__item--feature{% endif %}" {{ block.shopify_attributes }}>
          <a href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ collections[block.settings.collection].url }}{% endif %}" class="category-tile">
            {%- if tile_image != blank -%}
              <img src="{{ tile_image | image_url: width: 900 }}" alt="" loading="lazy">
            {%- endif -%}
            <span class="category-tile__wash" aria-hidden="true"></span>
            <span class="category-tile__label">
              <span>
                <span class="category-tile__name display">{{ block.settings.label }}</span>
                <span class="category-tile__note">{{ block.settings.note }}</span>
              </span>
              <span class="category-tile__arrow" aria-hidden="true">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M7 7h10v10"/></svg>
              </span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The edit" },
    { "type": "text", "id": "title", "label": "Title", "default": "Dress for the moment." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Sarees selected for their drape, detail and the occasions you will remember." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Supplies the link and, when no image is uploaded, the tile photo." },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "note", "label": "Note" },
        { "type": "url", "id": "link", "label": "Link override (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "label": "New arrivals", "note": "The latest pieces", "link": "/collections/new-arrivals" } },
        { "type": "tile", "settings": { "label": "Party wear", "note": "For evenings worth dressing for", "link": "/collections/party-wear-sarees" } },
        { "type": "tile", "settings": { "label": "Georgette", "note": "Light drapes, graceful movement", "link": "/collections/georgette-sarees" } },
        { "type": "tile", "settings": { "label": "Festive edit", "note": "Zari, embroidery and occasion colour", "link": "/collections/festive-sarees" } }
      ]
    }
  ]
}
{% endschema %}
