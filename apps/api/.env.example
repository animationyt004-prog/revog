# ---- apps/api environment ----
# Copy to .env and fill real values. NEVER commit .env.

# App
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:3000

# Database (Neon Postgres) — get from Neon dashboard, "Connection string"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Cache / rate-limit store (Upstash Redis) — "redis://..." from Upstash
REDIS_URL="redis://default:PASSWORD@HOST:PORT"

# Auth
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost

# Email OTP (Resend) — Phase 1. Leave blank in dev to console.log the OTP.
# The sender domain must be VERIFIED in Resend, otherwise every send is
# rejected. Until hyrafashions.com is verified there, Resend's shared
# onboarding sender is the only one that works — and it can only deliver to
# the Resend account owner's own address, not to real customers.
RESEND_API_KEY=
OTP_FROM_EMAIL="Hyra Fashion <login@hyrafashions.com>"

# Payments (Razorpay) — Phase 4
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Created with the webhook in the Razorpay dashboard (Settings > Webhooks),
# pointing at /api/payments/webhook and subscribed to payment.captured and
# payment.failed. Without it the endpoint refuses every call — it is the
# only thing proving a caller is Razorpay.
RAZORPAY_WEBHOOK_SECRET=

# Image storage (Cloudflare R2) — Phase 5
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# SMS OTP (Fast2SMS) — powers login-by-mobile and COD phone verification.
# BOTH are required to switch it on. Fast2SMS keeps the OTP route locked until
# its website verification is approved, so a key alone is not proof the channel
# works — and an unusable key blocks every COD order at checkout.
# Set the key to "TEST" to enable the flow with codes logged instead of sent.
SMS_OTP_ENABLED=false
FAST2SMS_API_KEY=

# Meta Conversions API (server-side; never expose token in NEXT_PUBLIC vars)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Every pixel the server reports to, comma-separated. REQUIRED: there is no
# built-in fallback, so leaving this (and META_PIXEL_ID above) blank disables
# server-side events entirely. Keep the two sides in step with the storefront's
# NEXT_PUBLIC_META_PIXEL_IDS: a pixel the browser hits but the server does not
# still loses everything iOS and ad blockers drop, and its Purchase match
# quality stays low because only the server sends hashed email/phone.
META_PIXEL_IDS=1696420768080535
# Only if one System User does NOT cover every pixel above — a per-pixel token,
# e.g. META_CAPI_ACCESS_TOKEN_1005602052307659=EAA...
# Otherwise every pixel reuses META_CAPI_ACCESS_TOKEN.
# Temporary, for Events Manager > Test Events only (e.g. TEST58125). Events
# carrying a test code are shown in that tool INSTEAD of being counted as
# conversions — always clear this again before/on production.
META_TEST_EVENT_CODE=

# Canonical storefront origin. Used as event_source_url on server-side Meta
# events, so it must match the domain the pixel actually runs on.
SITE_URL=https://www.hyrafashions.com

# Signs the per-order view token that order links carry instead of the buyer's
# email. Optional — falls back to JWT_ACCESS_SECRET. Changing either one
# invalidates already-sent order links (the email fallback still opens them).
ORDER_TOKEN_SECRET=
